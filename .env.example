# 复制为 .env 后在自己的服务器填写；不要提交或发送真实凭据。
QWEATHER_API_HOST=
QWEATHER_KID=
QWEATHER_ISS=
QWEATHER_SUB=
# 私钥用单引号包住，并把换行写成字面量 \n（或在单引号内保留实际换行）。
QWEATHER_PRIVATE_KEY=''

# Docker Compose 入口；在宿主机配置 HTTPS 反代时建议改为 127.0.0.1。
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
# 直接用 Node.js 启动默认不信任代理头；Compose 会在私网代理后覆盖为 true。
TRUST_PROXY=false
